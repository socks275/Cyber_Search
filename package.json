{
  "name": "cyberrevision",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:assets && npm run db:migrate && wrangler dev",
    "build:assets": "node scripts/build.mjs",
    "build": "npm run build:assets && wrangler deploy --dry-run --outdir dist/worker",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build:assets && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check app.js && node --check server/index.js",
    "types": "wrangler types",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "miniflare": "^5.20260921.1-alpha",
    "wrangler": "^4.138.0"
  }
}
